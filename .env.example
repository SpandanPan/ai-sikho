# Postgres — use Neon (neon.tech) or Supabase's Postgres, either works.
# Use the POOLED connection string for the app (handles many concurrent
# serverless function invocations without exhausting Postgres connections),
# and the DIRECT string only for running migrations.
DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host.region.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay (India-first payments — dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Vercel Cron auth — set the same value in Vercel's env vars.
# Prevents anyone else from triggering the news fetch route.
CRON_SECRET="generate with: openssl rand -base64 32"

# Comma-separated emails allowed to onboard mentors (/admin/mentors and the
# /api/admin/* routes). See src/lib/admin.ts.
ADMIN_EMAILS="you@example.com"

# Content-generation agents (/admin/generate) — NOT wired up in this
# environment, no key available for either. See src/lib/contentAgent.ts
# and src/lib/agentPricing.ts. Get keys at console.anthropic.com and
# platform.openai.com — see COSTS.md for the full "how do I access them"
# walkthrough and pricing.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"   # override if pricing/model id changes
# OPENAI_MODEL="gpt-6"                # override if pricing/model id changes
# USD_TO_INR_RATE="83"                # used only for suggested-price math

# Self-hosted open-source model via Ollama — $0/token, real and verified
# during this build (see AGENT_COSTS.md for exactly what was tested and
# why). Point this at wherever Ollama actually runs:
#   - Local dev: http://localhost:11434 (Ollama running on the same
#     machine as `npm run dev`) — no token needed, OLLAMA_AUTH_TOKEN can
#     stay unset.
#   - Production (deployed to Vercel): the small VPS's public HTTPS
#     domain, e.g. https://ollama.yourdomain.com — see DEPLOY.md for the
#     full setup (deploy/setup-vps.sh). localhost does NOT work here;
#     Vercel's serverless functions run in Vercel's cloud, not your laptop.
OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="gemma4:e4b"           # override if you pull a different model

# Required in production alongside the VPS domain above (leave unset for
# local dev against a bare localhost Ollama with no proxy in front of it).
# Must match the token deploy/setup-vps.sh generated and baked into the
# VPS's Caddy config — see DEPLOY.md. This is what stops anyone who finds
# your Ollama endpoint from using your compute for free.
# OLLAMA_AUTH_TOKEN=""

# OTP delivery — NOT wired up yet. Until one of these is added and
# src/app/api/auth/otp/request/route.ts is updated to call it, OTP codes are
# only logged server-side (see README > "Sign-in, and what requires it").
# MSG91_AUTH_KEY=""        # or TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN, for phone
# RESEND_API_KEY=""        # for email — also used by src/lib/email.ts (receipts/course-welcome/support)

# Email sending (src/lib/email.ts) — same RESEND_API_KEY above, NOT set in
# this environment, so every send is logged server-side instead of
# delivered (same pattern as OTP). EMAIL_DOMAIN drives three separate
# sender addresses (receipts@, courses@, support@) — purpose-separated so
# a receipt's deliverability never rides on whatever reputation a support
# reply or marketing-adjacent email builds up.
EMAIL_DOMAIN="example.com"

# Invoicing (src/lib/invoice.ts, /invoice/[id]) — BUSINESS_LEGAL_NAME and
# BUSINESS_ADDRESS appear on every invoice regardless. GST_NUMBER is
# deliberately unset by default: invoices show NO tax line at all unless
# this is set, because charging or displaying GST without being GST-
# registered isn't just wrong, it isn't allowed. Registration only becomes
# mandatory past ₹20 lakh/year turnover for services (₹10 lakh in a few
# special-category states) — see README's GST note. Confirm your actual
# status with a CA before setting this for real.
BUSINESS_LEGAL_NAME="AI Sikho"
BUSINESS_ADDRESS=""
# GST_NUMBER=""            # set only once actually GST-registered
# GST_RATE_PERCENT="18"    # override if a different SAC applies to your services

# Zoom Server-to-Server OAuth app (marketplace.zoom.us > Develop > Build App
# > Server-to-Server OAuth) — creates a unique meeting per paid mentor
# booking under your own Zoom account. NOT wired up in this environment, no
# key available. Free Zoom Basic account is enough: 1:1 meetings have no
# time limit (the 40-minute cap only applies to 3+ participants). Until
# these are set, each mentor's own personalMeetingUrl (set from their
# dashboard at /mentor) is used instead — a working, zero-setup fallback.
# See COSTS.md.
# ZOOM_ACCOUNT_ID=""
# ZOOM_CLIENT_ID=""
# ZOOM_CLIENT_SECRET=""
