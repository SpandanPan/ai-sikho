# Postgres — use Neon (neon.tech) or Supabase's Postgres, either works.
# Use the POOLED connection string for the app (handles many concurrent
# serverless function invocations without exhausting Postgres connections),
# and the DIRECT string only for running migrations.
DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host.region.neon.tech/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay (India-first payments — dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Vercel Cron auth — set the same value in Vercel's env vars.
# Prevents anyone else from triggering the news fetch route.
CRON_SECRET="generate with: openssl rand -base64 32"

# Comma-separated emails allowed to onboard mentors (/admin/mentors and the
# /api/admin/* routes). See src/lib/admin.ts.
ADMIN_EMAILS="you@example.com"

# Content-generation agents (/admin/generate) — NOT wired up in this
# environment, no key available for either. See src/lib/contentAgent.ts
# and src/lib/agentPricing.ts. Get keys at console.anthropic.com and
# platform.openai.com — see COSTS.md for the full "how do I access them"
# walkthrough and pricing.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"   # override if pricing/model id changes
# OPENAI_MODEL="gpt-6"                # override if pricing/model id changes
# USD_TO_INR_RATE="83"                # used only for suggested-price math

# OTP delivery — NOT wired up yet. Until one of these is added and
# src/app/api/auth/otp/request/route.ts is updated to call it, OTP codes are
# only logged server-side (see README > "Sign-in, and what requires it").
# MSG91_AUTH_KEY=""        # or TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN, for phone
# RESEND_API_KEY=""        # for email
