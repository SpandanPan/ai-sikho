// The Model Desk — data model
// Postgres via Neon/Supabase. Run `npm run prisma:migrate` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- NextAuth required models -------------------------------------------
// Standard NextAuth Prisma adapter shape. Don't rename these fields —
// next-auth reads them by convention.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts        Account[]
  sessions        Session[]
  quizAttempts    QuizAttempt[]
  progress        PathwayProgress[]
  purchases       Purchase[]
  courseProgress  CourseProgress[]
  courseRatings   CourseRating[]
  deviceSessions  DeviceSession[]
  mentorBookings  MentorBooking[]
  ledgerEntries   LedgerEntry[]
  analyticsEvents AnalyticsEvent[]
  mockAnswerSubmissions MockAnswerSubmission[]
  notes           Note[]
  bookmarks       Bookmark[]
  mentorProfile   Mentor?

  createdAt     DateTime  @default(now())
}

// One-time codes for the email/phone OTP sign-in flow (src/lib/otp.ts).
// Never stores the plaintext code — only a SHA-256 hash of it.
model OtpCode {
  id         String   @id @default(cuid())
  identifier String // normalized email or phone
  ip         String? // for the per-IP rate limit in src/lib/rateLimit.ts
  codeHash   String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([ip])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enforces the "max 2 signed-in devices" rule. Separate from NextAuth's own
// Session model because that one is only populated under the "database"
// session strategy, which NextAuth does not support alongside a Credentials
// provider (our OTP flow) — see src/lib/auth.ts. This table is managed by
// hand in the jwt callback instead.
model DeviceSession {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Product content -------------------------------------------------

// One day's set of 10 (quizDate, order 0-9) — either "curated" (hand-
// written, src/data/quizQuestions.ts) or "ollama" (generated fresh daily by
// the cron below). GET /api/quiz always serves today's row set if a full,
// valid set of 10 exists, and falls back to the curated set otherwise
// (cron hasn't run yet today, or today's generation failed validation) —
// see src/lib/dailyQuiz.ts. Historical days are kept, not deleted, for a
// simple audit trail of what a real visitor actually saw on a given day.
model QuizQuestion {
  id          String   @id @default(cuid())
  quizDate    DateTime // truncated to the day, UTC
  order       Int // 0-9 within that day
  question    String
  options     String[] // 4 options, plain text
  correctIdx  Int
  explanation String
  source      String   @default("curated") // "curated" | "ollama"
  active      Boolean  @default(true)

  createdAt DateTime @default(now())

  @@unique([quizDate, order])
  @@index([quizDate])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String? // null = anonymous attempt, still recorded for funnel analytics
  score     Int
  total     Int
  answers   Json // [{questionId, chosenIdx, correct}]
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PathwayPhase {
  id          String @id @default(cuid())
  order       Int    @unique
  title       String
  summary     String
  checkpoint  String

  progress PathwayProgress[]
}

model PathwayProgress {
  id       String   @id @default(cuid())
  userId   String
  phaseId  String
  done     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase PathwayPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseId])
}

// ---- Short courses -------------------------------------------------------
// Nominally priced, single-topic, includes a small hands-on demo where the
// topic supports one (see /courses). priceInPaise = 0 means free.

model Course {
  id            String  @id @default(cuid())
  slug          String  @unique
  order         Int     @unique
  title         String
  summary       String
  priceInPaise  Int
  hasDemo       Boolean @default(false)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
}

// Progress and ratings apply to every course, free or paid — tracking is a
// signed-in feature regardless of price (see CONTRIBUTING.md / README on
// which parts of the site require sign-in).
model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  courseSlug  String
  percent     Int       @default(0) // 0-100
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
}

model CourseRating {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
}

// ---- Commerce ----------------------------------------------------------

enum ProductSlug {
  STARTER_PACK // ₹100 teaser
  INTERVIEW_KIT // ₹999 / $29 full kit
  KIT_PLUS_MOCKS // ₹79–149 tier
  COURSE // individual short course, see Course.slug
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Purchase {
  id                String         @id @default(cuid())
  userId            String
  product           ProductSlug
  courseSlug        String? // set when product = COURSE, references Course.slug
  packTrack         String? // set when product = STARTER_PACK or INTERVIEW_KIT, references interviewPacks.ts's slug (e.g. "agentic-ai")
  amountInPaise     Int // the actual amount charged, AFTER any coupon discount — store money as integer paise/cents, never floats
  couponCode        String? // set if a coupon was applied — see src/lib/coupons.ts
  discountInPaise   Int?           @default(0) // how much the coupon knocked off; amountInPaise + discountInPaise = the pre-discount price
  currency          String         @default("INR")
  status            PurchaseStatus @default(PENDING)
  contentAccessed   Boolean        @default(false) // set true once a download/course-open endpoint exists; see src/lib/refunds.ts
  // NOT unique — a cart checkout creates one Purchase row per item, all
  // sharing one Razorpay order (and, once paid, one payment) for the
  // whole cart. The webhook (src/app/api/webhooks/razorpay) looks these
  // up by findMany, not findUnique, and flips all of them to PAID
  // together. See src/lib/cart.ts / POST /api/checkout.
  razorpayOrderId   String?
  razorpayPaymentId String?
  refundedAt        DateTime?
  invoiceNumber     String?        @unique // assigned lazily, once, the first time /invoice/[id] is opened — see src/lib/invoice.ts
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([razorpayOrderId])

  @@index([userId, status])
}

// Discounts, capped at 10% by application logic (src/lib/coupons.ts), not
// just convention — createCoupon rejects anything higher before it ever
// reaches this table.
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // stored upper-cased; comparisons are case-insensitive
  discountPercent Int // 1-10
  active          Boolean   @default(true)
  maxRedemptions  Int? // null = unlimited
  timesRedeemed   Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

// One global counter for sequential invoice numbers — a single row,
// incremented inside a transaction so two concurrent invoice views can
// never get the same number. Not per-year/financial-year sequencing (a
// real requirement once GST-registered and issuing "Tax Invoices" — see
// src/lib/invoice.ts) because that's a decision to make once registration
// is actually real, not before.
model InvoiceCounter {
  id         String @id @default("singleton")
  nextNumber Int    @default(1)
}

// The /help contact form. Deliberately not "no self-service mentor
// signup"-style admin-only — anyone should be able to reach support,
// signed in or not.
model SupportRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ip        String? // for the same per-IP rate limit pattern as OTP/inquiries
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Accounting ledger -----------------------------------------------------
// The single source of truth for the CA report (src/lib/ledger.ts,
// /api/admin/reports/accounting). Every entry is a signed line item:
// REVENUE and money in general are positive amounts, REFUND/PLATFORM_FEE/
// EXPENSE reduce profit — the report does the signing, this table just
// records raw amounts with a type so nothing is ambiguous.

enum LedgerEntryType {
  REVENUE // a sale, mirrors a Purchase or MentorBooking going PAID
  REFUND // money paid back out
  PLATFORM_FEE // Razorpay's cut of a transaction
  EXPENSE // hosting, SMS, AI generation cost, mentor payouts, anything else
}

model LedgerEntry {
  id              String          @id @default(cuid())
  type            LedgerEntryType
  amountInPaise   Int // always a positive magnitude; `type` gives it meaning
  category        String // e.g. "razorpay_fee", "hosting", "sms_otp", "mentor_payout", "ai_generation", "course_sale"
  description     String
  userId          String?
  purchaseId      String?
  occurredAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([userId])
}

// ---- AI content-generation agents -----------------------------------------
// Admin-triggered drafts, never auto-published — see src/lib/contentAgent.ts.
// Requires ANTHROPIC_API_KEY; without it, generation fails cleanly rather
// than silently producing nothing.

enum GenerationType {
  QUIZ
  ARTICLE
  ROADMAP
}

enum GenerationStatus {
  PENDING
  DONE
  FAILED
}

model ContentGenerationJob {
  id                     String           @id @default(cuid())
  type                   GenerationType
  topic                  String
  provider               String? // "anthropic" | "openai" — see src/lib/agentPricing.ts
  status                 GenerationStatus @default(PENDING)
  resultJson             Json?
  errorMessage           String?
  inputTokens            Int?
  outputTokens           Int?
  costInPaise            Int? // actual API spend for this job, auto-logged to LedgerEntry too
  suggestedPriceInPaise  Int? // cost * margin, see src/lib/agentPricing.ts
  requestedBy            String // admin's user id
  approvedAt             DateTime? // set once a human has reviewed and accepted the draft
  createdAt              DateTime         @default(now())

  @@index([type, status])
}

// ---- Mock-interview answer grading (a genuinely agent-native service) ----
// Unlike QUIZ/ARTICLE/ROADMAP drafts (admin-reviewed before publishing),
// this is a live, paid, customer-facing feature: someone submits a written
// answer, pays, and an LLM grades it against a rubric — the flagship "ML
// question with feedback" idea from the original plan. Fixed price below
// cost-justified: grading a few hundred words of input/output costs low
// single-digit rupees (see COSTS.md); ₹149 leaves a wide margin while still
// reading as an impulse price.

enum FeedbackStatus {
  PENDING // submitted, awaiting payment
  PAID // payment confirmed, grading not run yet (should be near-instant in practice)
  GRADED
  FAILED // payment succeeded but grading errored — see errorMessage
}

model MockAnswerSubmission {
  id             String         @id @default(cuid())
  userId         String
  category       String // e.g. "system-design", "behavioral", "rag"
  question       String
  answerText     String
  isFree         Boolean        @default(false) // one free, self-hosted-model grading per user per calendar month — see src/lib/mockFeedbackQuota.ts
  priceInPaise   Int            @default(14900) // ₹149; 0 when isFree
  status         FeedbackStatus @default(PENDING)
  provider       String? // which LLM graded it
  feedbackJson   Json? // {score, strengths[], gaps[], suggestion}
  errorMessage   String?
  costInPaise    Int? // actual grading API spend, auto-logged to LedgerEntry
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ---- Personal revision: notes & bookmarks ---------------------------------
// Entirely private per-user content — no admin ever reads these, no
// relation to anything else. The "quickly revise key concepts before an
// interview" feature on /profile.

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  tag       String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Mentoring ------------------------------------------------------------
// Onboarding a mentor (creating this row at all) stays admin-only via the
// admin routes (gated by ADMIN_EMAILS, see src/lib/admin.ts) — no
// self-service mentor signup. But once onboarded, the mentor signs in
// through the site's normal email/phone OTP flow (src/lib/auth.ts) — no
// separate mentor auth system — and userId links that login to this row, so
// /mentor (src/app/mentor/page.tsx) can tell "an onboarded mentor" apart
// from "any other signed-in user." Everything past onboarding — price,
// bio, availability, a personal meeting link — is self-service from there
// (see src/app/api/mentor/*).

model Mentor {
  id                String  @id @default(cuid())
  userId            String? @unique // linked at onboarding by email; null until that user's first sign-in creates the row
  name              String
  credentials       String // e.g. "Senior AI Engineer, 8 yrs, ex-Google"
  bio               String
  photoUrl          String?
  pricePerSessionInPaise Int
  personalMeetingUrl String? // fallback video link (mentor's own Zoom/Meet/Teams) — used when ZOOM_* env vars aren't set, see src/lib/zoom.ts
  active            Boolean @default(true)
  createdAt         DateTime @default(now())

  user     User?           @relation(fields: [userId], references: [id])
  slots    MentorSlot[]
  bookings MentorBooking[]
}

model MentorSlot {
  id        String   @id @default(cuid())
  mentorId  String
  startTime DateTime
  durationMinutes Int @default(30)
  booked    Boolean  @default(false)
  createdAt DateTime @default(now())

  mentor   Mentor          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  booking  MentorBooking?

  @@index([mentorId, startTime])
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

model MentorBooking {
  id                String        @id @default(cuid())
  userId            String
  mentorId          String
  slotId            String        @unique
  amountInPaise     Int
  status            BookingStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  // Video call link — filled in when the booking flips to PAID (see the
  // Razorpay webhook). meetingProvider is "zoom-api" (a unique per-session
  // Zoom meeting, when ZOOM_* env vars are set), "personal-link" (the
  // mentor's own static link, the free zero-setup fallback), or null (link
  // creation failed or the mentor set neither — shown as "pending" in the UI).
  meetingJoinUrl    String? // given to the customer
  meetingHostUrl    String? // given to the mentor (Zoom's host-only start_url when using the API; same as meetingJoinUrl for a personal link)
  meetingProvider   String?
  createdAt         DateTime      @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor Mentor     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  slot   MentorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mentorId])
}

// ---- Analytics --------------------------------------------------------
// Self-hosted, minimal-PII traffic tracking — one table, one public write
// endpoint (src/app/api/analytics/event). anonId is a random UUID a
// visitor's browser generates and keeps in localStorage, not tied to their
// identity; userId is filled in only when they happen to be signed in.
// Not a replacement for a real analytics product at scale, but real and
// queryable — see /admin/reports.

enum AnalyticsEventType {
  PAGE_VIEW
  CLICK
  TIME_ON_PAGE
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  path      String
  referrer  String?
  // Campaign attribution — captured client-side from the URL of whichever
  // page a visitor actually landed on (src/lib/trackEvent.ts), since
  // referrer alone only gives a domain ("google.com"), not which specific
  // post/ad/campaign sent them. Null for ordinary organic/direct visits.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  anonId    String // random per-browser id, not personally identifying on its own
  userId    String? // set only if the visitor was signed in at the time
  label     String? // e.g. which button was clicked, for CLICK events
  valueMs   Int? // duration, for TIME_ON_PAGE events
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([path])
  @@index([anonId])
  @@index([utmSource])
}

// ---- Newsletter -----------------------------------------------------
// The actual asset, per the original strategy plan — "more valuable than
// site traffic." Public signup, admin-only to read (src/lib/admin.ts).

model NewsletterSubscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  source          String? // where on the site they signed up, e.g. "homepage"
  unsubscribedAt  DateTime?
  createdAt       DateTime  @default(now())
}

// ---- Business automation inquiries -----------------------------------
// The "Work With Me" lead form. Public and unauthenticated on purpose — a
// business reaching out isn't necessarily an existing site user. Rate
// limited by IP (src/lib/rateLimit.ts's checkIpRateLimit) to stop spam,
// same pattern as OTP requests.

model ServiceInquiry {
  id        String   @id @default(cuid())
  service   String // a slug from src/data/automationServices.ts, or free text when "other"
  name      String
  email     String?
  phone     String?
  message   String?
  ip        String? // for the per-IP rate limit in src/app/api/inquiries/route.ts
  createdAt DateTime @default(now())

  @@index([ip])
}

// ---- AI Pulse news feed --------------------------------------------------
// Populated daily by scripts/fetch-news.ts (see vercel.json cron).

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  title       String
  summary     String
  link        String   @unique
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  // One independent sentence on why this matters, generated from ONLY the
  // title+summary above — never the full article — so there's no
  // substantial source text to reproduce or derive from in the first
  // place. Null until the daily cron backfills it (best-effort, once per
  // item — see src/lib/fetchNews.ts's generateMissingTakeaways).
  takeaway    String?

  @@index([publishedAt])
}

// One term a day, plain-language definition, generated by the same daily
// cron as the quiz. GET /api/term-of-day falls back to a small hand-
// written evergreen set (src/lib/termOfDay.ts) if today's row is missing.
model TermOfDay {
  id         String   @id @default(cuid())
  date       DateTime @unique // truncated to the day, UTC
  term       String
  definition String
  source     String   @default("ollama")
  createdAt  DateTime @default(now())
}
