// The Model Desk — data model
// Postgres via Neon/Supabase. Run `npm run prisma:migrate` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- NextAuth required models -------------------------------------------
// Standard NextAuth Prisma adapter shape. Don't rename these fields —
// next-auth reads them by convention.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  quizAttempts  QuizAttempt[]
  progress      PathwayProgress[]
  purchases     Purchase[]

  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Product content -------------------------------------------------

model QuizQuestion {
  id          String   @id @default(cuid())
  order       Int      @unique
  question    String
  options     String[] // 4 options, plain text
  correctIdx  Int
  explanation String
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String? // null = anonymous attempt, still recorded for funnel analytics
  score     Int
  total     Int
  answers   Json // [{questionId, chosenIdx, correct}]
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PathwayPhase {
  id          String @id @default(cuid())
  order       Int    @unique
  title       String
  summary     String
  checkpoint  String

  progress PathwayProgress[]
}

model PathwayProgress {
  id       String   @id @default(cuid())
  userId   String
  phaseId  String
  done     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase PathwayPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([userId, phaseId])
}

// ---- Short courses -------------------------------------------------------
// Nominally priced, single-topic, includes a small hands-on demo where the
// topic supports one (see /courses). priceInPaise = 0 means free.

model Course {
  id            String  @id @default(cuid())
  slug          String  @unique
  order         Int     @unique
  title         String
  summary       String
  priceInPaise  Int
  hasDemo       Boolean @default(false)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
}

// ---- Commerce ----------------------------------------------------------

enum ProductSlug {
  STARTER_PACK // ₹100 teaser
  INTERVIEW_KIT // ₹999 / $29 full kit
  KIT_PLUS_MOCKS // ₹79–149 tier
  COURSE // individual short course, see Course.slug
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Purchase {
  id                String         @id @default(cuid())
  userId            String
  product           ProductSlug
  courseSlug        String? // set when product = COURSE, references Course.slug
  amountInPaise     Int // store money as integer paise/cents, never floats
  currency          String         @default("INR")
  status            PurchaseStatus @default(PENDING)
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ---- AI Pulse news feed --------------------------------------------------
// Populated daily by scripts/fetch-news.ts (see vercel.json cron).

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  title       String
  summary     String
  link        String   @unique
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
}
