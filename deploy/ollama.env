# Systemd EnvironmentFile for ollama.service — makes the localhost-only
# bind explicit and version-controlled instead of relying on Ollama's
# default (which is also 127.0.0.1, but "explicit and documented" beats
# "implicit and hoping nobody changes it"). This is the actual security
# boundary: even if the Caddy token check in ../Caddyfile had a bug,
# Ollama still isn't reachable from outside this machine at all.
#
# Installed by setup-vps.sh to /etc/ollama.env, referenced by a systemd
# drop-in at /etc/systemd/system/ollama.service.d/override.conf.
OLLAMA_HOST=127.0.0.1:11434
